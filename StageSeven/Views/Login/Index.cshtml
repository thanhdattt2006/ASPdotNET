@{
    ViewBag.Title = "Login";
}
<h2>Đăng nhập</h2>
<p style="color:red">@ViewBag.Error</p>

<form asp-controller="Login" asp-action="Index" method="post">
    <input type="text" name="username" placeholder="Username (sa)" required />
    <input type="password" name="password" placeholder="Password (1234567)" required />
    <button type="submit">Vào lẹ</button>
</form>